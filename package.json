{
  "name": "pdfx",
  "productName": "PDFx",
  "version": "1.0.0",
  "description": "PDFX — a backwards-compatible PDF extension for multi-document files, with a minimal Windows viewer",
  "main": "./out/main/index.js",
  "author": "Alex Gounis",
  "license": "MIT",
  "scripts": {
    "format": "prettier --write .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "yarn typecheck:node && yarn typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev --watch",
    "build": "yarn typecheck && electron-vite build",
    "build:unpack": "yarn build && electron-builder --dir --win --x64",
    "build:win": "yarn build && electron-builder --win --x64"
  },
  "dependencies": {
    "@electron-toolkit/preload": "3.0.2",
    "@electron-toolkit/utils": "4.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "1.0.1",
    "@types/node": "22.19.21",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/d3-selection": "3.0.11",
    "@types/d3-zoom": "3.0.8",
    "@vitejs/plugin-react": "4.7.0",
    "d3-selection": "3.0.0",
    "d3-zoom": "3.0.0",
    "electron": "38.4.0",
    "electron-builder": "25.1.8",
    "electron-vite": "4.0.1",
    "fflate": "0.8.3",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.7.284",
    "prettier": "3.8.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "5.9.3",
    "vite": "7.3.5"
  }
}
